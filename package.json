{
  "name": "novel-name-plus",
  "version": "0.3.0",
  "private": true,
  "description": "Trình lọc NAME Trung–Việt dùng quyền ChatGPT Plus qua đăng nhập chính thức, chạy cục bộ",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/core.mjs && node --check src/quality.mjs && node --check src/international.mjs && node --check src/updater.cjs && node --check src/renderer.mjs && npm test",
    "pack:win": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@siwc/local": "file:./vendor/siwc-local",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.novelname.plus",
    "productName": "Novel NAME Plus",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "vendor/siwc-local/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Novel-NAME-Plus-${version}-${arch}.${ext}"
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Novel-NAME-Plus-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "tun2811bb-cloud",
      "repo": "novel-name-plus",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "Novel-NAME-Plus-Portable-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tun2811bb-cloud/novel-name-plus.git"
  }
}
