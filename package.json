{
  "name": "novel-name-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Trình lọc NAME Trung–Việt dùng quyền ChatGPT Plus qua đăng nhập chính thức, chạy cục bộ",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/core.mjs && node --check src/renderer.mjs && npm test",
    "pack:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@siwc/local": "file:./vendor/siwc-local"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.novelname.plus",
    "productName": "Novel NAME Plus",
    "directories": {"output": "release"},
    "files": ["src/**/*", "package.json", "node_modules/**/*", "vendor/siwc-local/**/*"],
    "win": {"target": ["portable"], "artifactName": "Novel-NAME-Plus-${version}-${arch}.${ext}"},
    "asar": true
  }
}
